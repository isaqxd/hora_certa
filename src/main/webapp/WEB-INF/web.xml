<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>Sistema de Medicamentos</display-name>

    <!-- Filtro de autenticação -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.saude.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Listener de inicialização do banco -->
    <listener>
        <listener-class>com.saude.listener.AppListener</listener-class>
    </listener>

    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.saude.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.saude.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.saude.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TrocarSenhaServlet</servlet-name>
        <servlet-class>com.saude.controller.TrocarSenhaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrocarSenhaServlet</servlet-name>
        <url-pattern>/trocar-senha</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MedicamentoServlet</servlet-name>
        <servlet-class>com.saude.controller.MedicamentoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicamentoServlet</servlet-name>
        <url-pattern>/medicamentos/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PacienteServlet</servlet-name>
        <servlet-class>com.saude.controller.PacienteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PacienteServlet</servlet-name>
        <url-pattern>/pacientes/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- RF02: Timeout de sessão = 30 minutos -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/login</location>
    </error-page>
</web-app>
